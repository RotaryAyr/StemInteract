_*"b051633ea639a7d4ed2b7d3ad6a4f08acdc8af3a"_$X-Forwarded-Protocol,Accept-EncodingZSAMEORIGIN“/0~_NSMutableDictionary£~Ä3\NSDictionary_text/javascript“/0ÉÑ_NSHTTPURLResponse£ÖÜ3_NSHTTPURLResponse]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀ì␀ô␀¥␀÷␀¯␀˚ BIknqìµ∏∫ºæ¿¬ƒ∆»…ÀÕœ—ÿ‡ÏÓÚ"-6<?HQSU\doÇÑÜàäåéêíîñòöúû†¢µ∑πªΩø¡√≈«…ÀÕœ—”’◊‰Ú'9GLhwÄôû£µ’ı˙#EaÅ∞∑√À¯		*	/	E	I	V	h	m	Å	Ö	ô␀␀␀␀␀␀␀␀␀␀␀␀␀á␀␀␀␀␀␀␀␀␀␀␀␀␀␀	ß_(https://www.sqa.org.uk/sqa/wro/footer.js‘ !"#O5// code to add exam info to essential/mandatory info accordion
// assumes there is a #course-info id under #center 

const ttLink = '<p><a href="https://www.sqa.org.uk/sqa/41619.html">Timetable and exam apps</a></p>';

let div, header, q, s, accHeading;

// font awesome icon
const faIcon = document.createElement("i");
faIcon.className = "fa fa-plus";
faIcon.setAttribute("aria-hidden", "true");

// get subject and level from page h1
// headers=document.getElementsByTagName("H1");
// header = headers[0].innerHTML;

header = $('#center h1').html();

if (header.substring(0, 10) == "National 5") {
    q = "National 5";
    s = header.substring(11);
} else if (header.substring(0, 6) == "Higher") {
    q = "Higher";
    s = header.substring(7);
} else if (header.substring(0, 15) == "Advanced Higher") {
    q = "Advanced Higher";
    s = header.substring(16);
}
if (s=="ESOL") {
    s = "English for Speakers of Other Languages";     
}

if (s=="G\u00E0idhlig") {
    createAccordion("When are the exams?", getGaidhligText(q), false);
} else {
    fetchExamData(q, s)   
} 

async function fetchExamData(q, s) {
    const url = 'https://www.sqa.org.uk/timetable/timetable/search';
    const queryParams = new URLSearchParams({ q, s }).toString();
    const fullUrl = `${url}?${queryParams}`;
    try {
        const response = await fetch(fullUrl);
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        const exams = await response.json();
        if (exams.length > 0) {
            const accHeading = exams.length === 1 ? 'When is the exam?' : 'When are the exams?';
            let examsOutput = '';
            for (const exam of exams) {
                examsOutput += `${q} ${s} ${exam.paper}</span> is on ${getDay(exam.examDate.day)} ${exam.examDate.date} ${getMonth(exam.examDate.month)} ${getYear(exam.examDate.year)} from ${exam.fromTime1} to ${exam.toTime1}.<br />`;
            }
            createAccordion(accHeading, examsOutput, true);
        }
    } catch (error) {
        console.error('Error:', error);
    }
}
function createAccordion(accHeading, examsOutput, addListener) {
    const accordionHeader = document.createElement("h2");
    accordionHeader.className = "sqa-accordion-header";
    accordionHeader.setAttribute("tabIndex", 0);
    accordionHeader.setAttribute("role", "button");
    accordionHeader.textContent = accHeading;
    accordionHeader.appendChild(faIcon);
    if (addListener) {
        accordionHeader.addEventListener("click", slideExamPanel);
        accordionHeader.addEventListener("keyup", slideExamPanel);
    }
    const accordionContent = document.createElement("div");
    accordionContent.style.display = "none";
    accordionContent.innerHTML = `<p>${examsOutput}</p>${ttLink}`;
    let accordion = document.createElement("div");
    accordion.className = "sqa-accordion";
    accordion.id = "exam-info";
    accordion.appendChild(accordionHeader);
    accordion.appendChild(accordionContent);
    const courseInfo = document.querySelector('#course-info');
    if (courseInfo) {
        courseInfo.parentNode.insertBefore(accordion, courseInfo.nextSibling);
    }
}

// accordion function taken from core.css
function slideExamPanel(event) {
    if (event.type === "click" || event.keyCode === 32) {
        const icon = this.children[0];
        icon.classList.toggle("fa-plus");
        icon.classList.toggle("fa-minus");
        if (this.classList.contains("activeTab")) {
            this.setAttribute("aria-expanded", "false");
            this.setAttribute("aria-selected", "false");
            this.nextElementSibling.setAttribute("aria-hidden", "true");
            this.nextElementSibling.style.display = "none";
            this.classList.remove("activeTab");
        } else {
            this.setAttribute("aria-expanded", "true");
            this.setAttribute("aria-selected", "true");
            this.nextElementSibling.setAttribute("aria-hidden", "false");
            this.nextElementSibling.style.display = "block";
            this.classList.add("activeTab");
        }
    }
}

//helper functions

function getMonth(pMonth) {
    let monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    return monthNames[pMonth];
}

function getDay(pDay) {
    let dayNames = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
    return dayNames[pDay];
}

function getYear(pYear) {
    return pYear + 1900;
}

function getPaper(pPaper) {
    if (typeof pPaper === 'undefined' || !pPaper) {
        return "exam";
    } else {
        if (!pPaper.includes('Paper')) {
          pPaper+= " Paper"
        }
        return pPaper;
    }
}

function getGaidhligText(q) {
    switch (q) {
        case "National 5":
            text=  "National 5 <span lang=\"gd\">G\u00E0idhlig Leughadh agus Litreachas</span> is on Thursday 29 April 2027 from 09:00 to 10:40.<br />";
            text+= "National 5 <span lang=\"gd\">G\u00E0idhlig \u00C8isteachd</span> is on Friday 29 April 2027 from 11:10 to 11:35.<br />";
            break;
        case "Higher":
            text=  "Higher <span lang=\"gd\">G\u00E0idhlig Leughadh agus Litreachas</span> is on Wednesday 28 April 2027 from 13:10 to 15:00.<br />";
            text+= "Higher <span lang=\"gd\">G\u00E0idhlig \u00C8isteachd</span> is on Wednesday 28 April 2027 from 15:30 to 16:10.<br />";
            break;
        case "Advanced Higher":
            text = "Advanced Higher <span lang=\"gd\">G\u00E0idhlig Sgr\u00F9dadh</span> is on Wednesday 28 April 2027 from 09:00 to 10:30.<br />";
            text += "Advanced Higher <span lang=\"gd\">G\u00E0idhlig Litreachas agus Sgr\u00ECobhadh</span> is on Wednesday 28 April 2027 from 11:00 to 12:40.<br />";
            text += "Advanced Higher <span lang=\"gd\">G\u00E0idhlig Eadar-theangachadh</span> is on Wednesday 28 April 2027 from 13:30 to 14:00.<br />";
            break;
    }
    return text;
}

// end helper functions
