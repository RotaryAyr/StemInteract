            #searchUS input.text_filter {width:79%;}
            #searchUS select.smallSelect, #Status select {width:34%;}
            #searchUS div.smallDiv {width:50%; display:block; float:left;;}
            #searchUS div.smallDiv input {width:26%; }
            #searchUS div.smallDiv span.label {width:26%;margin-right:2%; margin-top:3px;}
            #searchUS div {margin:8px 0;}
            table#us td:nth-child(4), table#scqf td:nth-child(5) {text-align:center;}
            #us_filter input {width:400px;}
            table td:nth-child(3), table td:nth-child(4),table td:nth-child(7) { text-align:center;}
            #usf_filter label {font-weight:bold}
    </style>

