$(function(){$('.document-list-title').each(function(i,el){$(this).prepend('<input id="mcb'+i+'" type="checkbox" class="master-checkbox" />');$(this).children('p').contents().unwrap().wrap(function(){return'<label for="mcb'+i+'"  ></label>';});});$('input.master-checkbox').click(function(){$(this).parents('.document-list').find('ul input[type="checkbox"]').attr('checked',this.checked);updateDocumentCount()});$('.document-list-content').each(function(i,el){$(el).find('input[type="checkbox"]').click(function(){var peers=$(this).parents('.document-list-content').find('input[type="checkbox"]');if(peers.length===peers.filter(':checked').length){$(this).parents('.document-list').find('.master-checkbox').attr('checked','checked');}else{$(this).parents('.document-list').find('.master-checkbox').removeAttr('checked');}
