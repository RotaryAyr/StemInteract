/0OC/* New js for header 2026 with updated html markup from SQA static app feedback*/
/* The anchor tag id with the dropdown div id*/
document.addEventListener("DOMContentLoaded", () => {
  const dropdowns = [
    {
      toggleId: "qualifications-toggle",
      dropdownId: "qualifications-dropdown",
    },
    { toggleId: "deliver-toggle", dropdownId: "deliver-dropdown" },
    { toggleId: "menu-toggle", dropdownId: "menu-dropdown" },
  ];

  /* Aria attributes*/

  function setAriaAttributes(toggle, isOpen) {
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    toggle.setAttribute(
      "aria-label",
      isOpen
        ? `Close ${toggle.textContent.trim()} menu`
        : `Open ${toggle.textContent.trim()} menu`,
    );
  }

  /* Open and active states for toggling and styling*/

  function toggleDropdownState(dropdown, listItem, toggle, isOpen) {
    dropdown.classList.toggle("open", isOpen);
    listItem.classList.toggle("active", isOpen);
    const links = dropdown.querySelectorAll("a");
    links.forEach((link) => (link.tabIndex = isOpen ? 0 : -1));
  }

  /* When dropdown is clicked how to get the links to be tabbable and then back to main nav when done*/

  function setupDropdownFocus(toggle, dropdown, listItem, dropdowns) {
    const links = Array.from(dropdown.querySelectorAll("a"));

    toggle.addEventListener("click", () => {
      // Close all other dropdowns
      dropdowns.forEach((d) => {
        if (d.dropdownId !== dropdown.id) {
          const otherDropdown = document.getElementById(d.dropdownId);
          const otherToggle = document.getElementById(d.toggleId);
          const otherLi = otherToggle.closest("li");
          toggleDropdownState(otherDropdown, otherLi, otherToggle, false);
          setAriaAttributes(otherToggle, false);
        }
      });

      const isOpen = !dropdown.classList.contains("open");
      toggleDropdownState(dropdown, listItem, toggle, isOpen);
      setAriaAttributes(toggle, isOpen);

      if (isOpen) links[0]?.focus();
    });

    dropdown.addEventListener("keydown", (e) => {
      const firstLink = links[0];
      const lastLink = links[links.length - 1];

      if (e.key === "Escape") {
        toggleDropdownState(dropdown, listItem, toggle, false);
        setAriaAttributes(toggle, false);
        toggle.focus();
      }

      if (e.key === "Tab") {
        if (e.shiftKey && document.activeElement === firstLink) {
          toggleDropdownState(dropdown, listItem, toggle, false);
          setAriaAttributes(toggle, false);
          toggle.focus();
          e.preventDefault();
        } else if (!e.shiftKey && document.activeElement === lastLink) {
          toggleDropdownState(dropdown, listItem, toggle, false);
          setAriaAttributes(toggle, false);

          // Move focus to next nav item
          let nextLi = listItem.nextElementSibling;
          while (
            nextLi &&
            !nextLi.querySelector("button.nav-btn, a.nav-link")
          ) {
            nextLi = nextLi.nextElementSibling;
          }
          nextLi?.querySelector("button.nav-btn, a.nav-link")?.focus();
          e.preventDefault();
        }
      }
    });
  }

  // Initialize all dropdowns
  dropdowns.forEach((d) => {
    const toggle = document.getElementById(d.toggleId);
    const dropdown = document.getElementById(d.dropdownId);
    const listItem = toggle.closest("li");

    // Initial ARIA
    setAriaAttributes(toggle, false);
    // Hide all links initially from tab order
    dropdown.querySelectorAll("a").forEach((link) => (link.tabIndex = -1));

    setupDropdownFocus(toggle, dropdown, listItem, dropdowns);
  });

  /* Mobile menu li - sub menu */
  document
    .querySelectorAll(".mobile-dropdown .has-submenu > a")
    .forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        trigger.parentElement.classList.toggle("open"); // only toggles the class
      });
    });

  document
    .querySelectorAll(".mobile-dropdown .has-submenu > button.submenu-trigger")
    .forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const isOpen = trigger.parentElement.classList.toggle("open");
        trigger.setAttribute("aria-expanded", String(isOpen));
      });
    });
});
