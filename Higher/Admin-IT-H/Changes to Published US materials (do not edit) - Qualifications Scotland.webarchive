$( document ).ready(function() { 
    const arrow = ["<span id='left-arrow' class='icon icon-arrow-left'></span>","<span id='right-arrow' class='icon icon-arrow-right'></span>"];
    var owl = $('.owl-carousel');
    owl.owlCarousel({
        loop:true,
        margin:0,
        nav:true,
        smartSpeed: 1000,
        navText: arrow,
        autoplay:false,
        autoplayTimeout:7000,
        autoplayHoverPause:true,
        responsive:{
            0:{
                items:1
            },
            600:{
                items:1
            },
            1000:{
                items:1,
                loop:false
            }
        }
    });

    $(".owl-prev").attr('aria-label', 'Previous slide');
    $(".owl-prev").attr('title', 'Previous slide');
    $(".owl-next").attr('aria-label', 'Next slide');
    $(".owl-next").attr('title', 'Next slide');
    $('.owl-carousel').attr('aria-label', 'Main carousel');
    $('#pauseButton').attr('aria-label', 'Play main carousel');
    
    $('.owl-prev').attr("title", "previous");
    $('.owl-next').attr("title", "next");
    $('button.owl-prev, button.owl-next').removeAttr("role");

    owl.trigger('stop.owl.autoplay');
    $(".owl-play-pause").attr("id", "playButton");
    $(".owl-play-pause").html("<i class=\"fa fa-play\"></i>");

    $(".owl-play-pause").click(function () {
        if ($(this).attr("id") === "pauseButton") {
        $(this).attr('aria-label', 'Play main carousel');
            owl.trigger('stop.owl.autoplay')
            $(this).attr("id", "playButton");
            $(this).html("<i class=\"fa fa-play\"></i>");
        } else {
        $(this).attr('aria-label', 'Pause main carousel');  
            owl.trigger('play.owl.autoplay',[7000])
            $(this).attr("id", "pauseButton");
            $(this).html("<i class=\"fa fa-pause\"></i>");
        }
    });

    $('.owl-carousel').each(function() {
        $(this).find('.owl-dot').each(function(index) {
            $(this).attr('aria-label', 'Slide ' + (index + 1));
        $(this).attr('id', 'Slide_' + (index + 1));
        });
    });

    if (window.innerWidth <= 768) {
        $("#slider-content").hide();
    }


    
    $('.owl-item .item').removeAttr('tabindex');
    
    $('.owl-item').each(function(index) {
        $(this).attr('id', 'slide_' + index);
    });
    
    $('#slide_0').find('a').attr('tabindex', 0);

    owl.on('changed.owl.carousel', function(event) {
    var item = event.item.index; 
    $('.owl-item').each(function(index) {
        if (index != item) {
            $('#slide_' + index).find('a').attr('tabindex', -1);
        } else {
            $('#slide_' + index).find('a').attr('tabindex', 0);
        }
    });
    })
    
    $("<p class='owl-arrows-navigation-message' aria-live='polite'>Use left and right arrow keys to navigate</p>").insertBefore(".owl-dots");
    
    $(".owl-play-pause, .owl-prev, .owl-next, .owl-dot, .slidershowLink").focus(function() {
          $(".owl-arrows-navigation-message").css("display", "block");
    });

    $(".owl-play-pause, .owl-prev, .owl-next, .owl-dot, .slidershowLink").on("focusout", function() {
          $(".owl-arrows-navigation-message").css("display", "none");
    });
    
    
    $.fn.onClassChange = function(cb) {
      return $(this).each((_, el) => {
        new MutationObserver(mutations => {
          mutations.forEach(mutation => cb && cb(mutation.target, mutation.target.className));
        }).observe(el, {
          attributes: true,
          attributeFilter: ['class'] // only listen for class attribute changes 
        });
      });
    }
    
    $(".owl-prev").attr("aria-disabled", true);
    $(".owl-prev").attr("tabindex", -1);
    $(".owl-prev").onClassChange((el, newClass) => {
        if ($(el).hasClass("disabled")) {
            $(el).attr("aria-disabled", true);  
            $(el).attr("tabindex", -1);
        } else {
            $(el).removeAttr("aria-disabled");  
            $(el).removeAttr("tabindex");
        }
    });
    
    $(".owl-next").onClassChange((el, newClass) => {
        if ($(el).hasClass("disabled")) {
            $(el).attr("aria-disabled", true);  
            $(el).attr("tabindex", -1);
        } else {
            $(el).removeAttr("aria-disabled");  
            $(el).removeAttr("tabindex");
        }
    });


    var qualificationsliSelected;
    var qualificationsliIdx;
    var supportliSelected;
    var supportliIdx;
    var servicesliSelected;
    var servicesliIdx;
    var insideQualsSubMenu = true;
    var insideServicesSubMenu = true;

    var isMobileView = false;


    $( "#qualifications-menu" ).click(function(event) {
        event.preventDefault();

        $('.header-links li.hasSub').each(function() {
            //set the 'aria-expanded' attribute to false to all buttons under the header-links class
            $(this).find("button").attr('aria-expanded', false);

            //remove the 'sub-open' class from all items
            $('.sub-open').removeClass('sub-open');
        });
    
        if ($( "#qualifications-menu" ).attr("aria-expanded") == "false") {
            $( "#qualifications-menu" ).attr("aria-expanded", "true");

            if (qualificationsliSelected) {
                qualificationsliSelected.removeClass('nav-link-selected');    
            }
            qualificationsliSelected = null;
            qualificationsliIdx = 0;
            insideQualsSubMenu = true;
            $("#qualifications-menu").parent().attr("aria-expanded", "true");

        } else {
            $( "#qualifications-menu" ).attr("aria-expanded", "false");
            $( "#qualifications-menu" ).parent().attr("aria-expanded", "false");
        }

        $( "#services-menu" ).attr("aria-expanded", "false");
        $( "#services-menu" ).parent().attr("aria-expanded", "false");
        $( "#support-menu" ).attr("aria-expanded", "false");

        if(window.innerWidth > 770) {
            isMobileView = false;
            $( "#services-subnav" ).hide();
            $( "#services-menu" ).closest("li").removeClass("active-link");

            $( "#support-subnav" ).hide();
            $( "#support-menu" ).closest("li").removeClass("active-link");

            $( "#qualifications-subnav" ).slideToggle( "slow");
            $( "#qualifications-menu" ).closest("li").toggleClass("active-link");

            $( "#qualifications-mob-subnav" ).hide();
            $( "#services-mob-subnav" ).hide();
            $( "#support-mob-subnav" ).hide();

            $( "#qualifications-menu" ).removeClass("hasSub-opened");   
            $( "#services-menu" ).removeClass("hasSub-opened");
            $( "#support-menu" ).removeClass("hasSub-opened");

        } else {
            isMobileView = true;
            $( "#services-mob-subnav" ).hide();
            $( "#services-menu" ).closest("li").removeClass("active-link");

            $( "#support-mob-subnav" ).hide();
            $( "#support-menu" ).closest("li").removeClass("active-link");

            $( "#qualifications-mob-subnav" ).slideToggle( "slow");
            $( "#qualifications-menu" ).toggleClass("active-link");

            $( "#qualifications-menu" ).toggleClass("hasSub-opened");   
            $( "#services-menu" ).removeClass("hasSub-opened");
            $( "#support-menu" ).removeClass("hasSub-opened");
        }
      });




      $( "#services-menu" ).click(function(event) {
        event.preventDefault();

        $('.header-links li.hasSub').each(function() {

            //set the 'aria-expanded' attribute to false to all buttons under the header-links class
            $(this).find("button").attr('aria-expanded', false);

            //remove the 'sub-open' class from all items
            $('.sub-open').removeClass('sub-open');

        });

        if ($( "#services-menu" ).attr("aria-expanded") == "false") {
            $( "#services-menu" ).attr("aria-expanded", "true");

            if (servicesliSelected) {
                servicesliSelected.removeClass('nav-link-selected');
            }
            servicesliSelected = null;
            servicesliIdx = 0;
            insideServicesSubMenu = true;
            $( "#services-menu" ).parent().attr("aria-expanded", "true");

        } else {
            $( "#services-menu" ).attr("aria-expanded", "false");
            $( "#services-menu" ).parent().attr("aria-expanded", "false");
        }

        $( "#qualifications-menu" ).attr("aria-expanded", "false");
        $( "#qualifications-menu" ).parent().attr("aria-expanded", "false");
        $( "#support-menu" ).attr("aria-expanded", "false");

        if (window.innerWidth > 770) {
            isMobileView = false;
            $( "#qualifications-subnav" ).hide();
            $( "#qualifications-menu" ).closest("li").removeClass("active-link");

            $( "#support-subnav" ).hide();
            $( "#support-menu" ).closest("li").removeClass("active-link");

            $( "#services-subnav" ).slideToggle( "slow");
            $( "#services-menu" ).closest("li").toggleClass("active-link");

            $( "#qualifications-mob-subnav" ).hide();
            $( "#services-mob-subnav" ).hide();
            $( "#support-mob-subnav" ).hide();
    
            $( "#qualifications-menu" ).removeClass("hasSub-opened");   
            $( "#services-menu" ).removeClass("hasSub-opened");
            $( "#support-menu" ).removeClass("hasSub-opened");

        } else {
            isMobileView = true;
            $( "#qualifications-mob-subnav" ).hide();
            $( "#qualifications-menu" ).closest("li").removeClass("active-link");

            $( "#support-mob-subnav" ).hide();
            $( "#support-menu" ).closest("li").removeClass("active-link");

            $( "#services-mob-subnav" ).slideToggle( "slow");
            $( "#services-menu" ).toggleClass("active-link");

            $( "#services-menu" ).toggleClass("hasSub-opened");
            $( "#qualifications-menu" ).removeClass("hasSub-opened");
            $( "#support-menu" ).removeClass("hasSub-opened");
        }
      });

      $( "#support-menu" ).click(function(event) {
        event.preventDefault();

        if ($( "#support-menu" ).attr("aria-expanded") == "false") {
            $( "#support-menu" ).attr("aria-expanded", "true");

            if (supportliSelected) {
                supportliSelected.removeClass('nav-link-selected');    
            }
            supportliSelected = null;
            supportliIdx = 0;

        } else {
            $( "#support-menu" ).attr("aria-expanded", "false");
        }

        $( "#qualifications-menu" ).attr("aria-expanded", "false");
        $( "#services-menu" ).attr("aria-expanded", "false");
        
        if(window.innerWidth > 770){
            $( "#services-subnav" ).hide();
            $( "#services-menu" ).closest("li").removeClass("active-link");

            $( "#qualifications-subnav" ).hide();
            $( "#qualifications-menu" ).closest("li").removeClass("active-link");

            $( "#support-subnav" ).slideToggle( "slow");
            $( "#support-menu" ).closest("li").toggleClass("active-link");

            $( "#qualifications-mob-subnav" ).hide();
            $( "#services-mob-subnav" ).hide();
            $( "#support-mob-subnav" ).hide();
    
            $( "#qualifications-menu" ).removeClass("hasSub-opened");   
            $( "#services-menu" ).removeClass("hasSub-opened");
            $( "#support-menu" ).removeClass("hasSub-opened");

        } else {
            $( "#services-mob-subnav" ).hide();
            $( "#services-menu" ).closest("li").removeClass("active-link");

            $( "#qualifications-mob-subnav" ).hide();
            $( "#qualifications-menu" ).closest("li").removeClass("active-link");

            $( "#support-mob-subnav" ).slideToggle( "slow");
            $( "#support-menu" ).toggleClass("active-link");

            $( "#support-menu" ).toggleClass("hasSub-opened");
            $( "#services-menu" ).removeClass("hasSub-opened");
            $( "#qualifications-menu" ).removeClass("hasSub-opened");
        }
      });


    $(".qualification-search").on("click", function(event) {
        event.preventDefault();
        homeSearchQual();
    });

    $(".qualification-input").on('keyup', function (e) {
        if (e.keyCode === 13) {
            homeSearchQual();
        }
    });

    $(".international-qualification-search").on("click", function(event) {
        event.preventDefault();
        homeSearchInternationalQual();
    });

    $(".international-qualification-input").on('keyup', function (e) {
        if (e.keyCode === 13) {
            homeSearchInternationalQual();
        }
    });


    $(".unit-search").on("click", function(event) {
        event.preventDefault();
        homeSearchUnit();
    });

    $(".unit-input").on('keyup', function (e) {
        if (e.keyCode === 13) {
            homeSearchUnit();
        }
    });




    /* Arrow keys navigation (up & down) */
    var qualificationsli = $('#qualifications-subnav div div ul li');
    var qualificationsliLength = qualificationsli.length;

    var qualificationsli_mob = $('#qualifications-mob-subnav div ul li');
    var qualificationsliLength_mob = qualificationsli_mob.length;


    $(window).keydown(function(e) {

        if ((e.which === 38 || (e.shiftKey && (e.keyCode == 9 || e.key === 'Tab'))) && $("#qualifications-menu").attr("aria-expanded") == "true") {
            e.preventDefault();
            if (qualificationsliSelected) {
                qualificationsliSelected.removeClass('nav-link-selected');
                qualificationsliIdx = qualificationsliIdx - 1;
                if (qualificationsliIdx < 0) {
                    // close sub nav and send focus to qual menu
                    insideQualsSubMenu = false;
                    qualificationsliSelected = null;
                    qualificationsliIdx = 0;
                    $('#qualifications-menu').click();
                    $('#qualifications-menu').focus();
                }
            } else {
                qualificationsliIdx = qualificationsliLength - 1;
            }


            if (insideQualsSubMenu) {

                if (!isMobileView) {
                    qualificationsliSelected = $(qualificationsli).eq(qualificationsliIdx).addClass('nav-link-selected');
                } else {
                    qualificationsliSelected = $(qualificationsli_mob).eq(qualificationsliIdx).addClass('nav-link-selected');
                }

                $(qualificationsliSelected).find('a').focus(); 
                
            }
            
        } else if ((e.which === 40 || (e.key === 'Tab' || e.keyCode === 9)) && $("#qualifications-menu").attr("aria-expanded") == "true") {
            e.preventDefault();
            if (qualificationsliSelected) {
                qualificationsliSelected.removeClass('nav-link-selected');
                qualificationsliIdx = qualificationsliIdx + 1;
                if (qualificationsliIdx > qualificationsliLength) {
                    // close sub nav and send focus to services menu
                    insideQualsSubMenu = false;
                    qualificationsliSelected = null;
                    qualificationsliIdx = 0;
                    $('#qualifications-menu').click();
                    $('#qualifications-menu').focus();
                }
            } else {
                qualificationsliIdx = 0;
            }

            if (insideQualsSubMenu) {

                if (!isMobileView) {
                    qualificationsliSelected = $(qualificationsli).eq(qualificationsliIdx).addClass('nav-link-selected');
                } else {
                    qualificationsliSelected = $(qualificationsli_mob).eq(qualificationsliIdx).addClass('nav-link-selected');
                }

                $(qualificationsliSelected).find('a').focus();
            }
        }  
    });

    var servicesli = $('#services-subnav div div ul li');
    var servicesliLength = servicesli.length;

    var servicesli_mob = $('#services-mob-subnav div ul li');
    var servicesliLength_mob = servicesli_mob.length;


    $(window).keydown(function(e) {
        if ((e.which === 38 || (e.shiftKey && (e.keyCode == 9 || e.key === 'Tab'))) && $("#services-menu").attr("aria-expanded") == "true") {
            e.preventDefault();
            if (servicesliSelected) {
                servicesliSelected.removeClass('nav-link-selected');
                servicesliIdx = servicesliIdx - 1;
                if (servicesliIdx < 0) {
                    // close sub nav and send focus to services menu
                    insideServicesSubMenu = false;
                    servicesliSelected = null;
                    servicesliIdx = 0;
                    $('#services-menu').click();
                    $('#services-menu').focus();
                }
            } else {
                servicesliIdx = servicesliLength - 1;
            }

            if (insideServicesSubMenu) {
                if (!isMobileView) {
                    servicesliSelected = $(servicesli).eq(servicesliIdx).addClass('nav-link-selected');
                } else {
                    servicesliSelected = $(servicesli_mob).eq(servicesliIdx).addClass('nav-link-selected');
                }
                
                $(servicesliSelected).find('a').focus();
            }
        } else  if ((e.which === 40 || (e.key === 'Tab' || e.keyCode === 9)) && $("#services-menu").attr("aria-expanded") == "true") {
            e.preventDefault();
            if (servicesliSelected) {
                servicesliSelected.removeClass('nav-link-selected');
                servicesliIdx = servicesliIdx + 1;
                if (servicesliIdx > servicesliLength) {
                    // close sub nav and send focus to past papers menu
                    insideServicesSubMenu = false;
                    servicesliSelected = null;
                    servicesliIdx = 0;
                    $('#services-menu').click();
                    $('#services-menu').focus();
                }
            } else {
                servicesliIdx = 0;
            }
            if (insideServicesSubMenu) {
                if (!isMobileView) {
                    servicesliSelected = $(servicesli).eq(servicesliIdx).addClass('nav-link-selected');
                } else {
                    servicesliSelected = $(servicesli_mob).eq(servicesliIdx).addClass('nav-link-selected');
                }
                $(servicesliSelected).find('a').focus();
            }
        } 
    });

    var supportli = $('#support-subnav div div ul li');
    var supportliLength = supportli.length;
    
    $(window).keydown(function(e){
        if (e.which === 40 && $( "#support-menu" ).attr("aria-expanded") == "true") {
            e.preventDefault();
            if (supportliSelected) {
                supportliSelected.removeClass('nav-link-selected');
                supportliIdx = supportliIdx + 1;
                if (supportliIdx > supportliLength) {
                    supportliIdx = supportliLength;
                }
            } else {
                supportliIdx = 0;
            }
            supportliSelected = $(supportli).eq(supportliIdx).addClass('nav-link-selected');
            $(supportliSelected).find('a').focus();
        } else if (e.which === 38 && $( "#support-menu" ).attr("aria-expanded") == "true") {
            e.preventDefault();
            if (supportliSelected) {
                supportliSelected.removeClass('nav-link-selected');
                supportliIdx = supportliIdx - 1;
                if (supportliIdx < 0) {
                    supportliIdx = 0;
                } 
            } else {
                supportliIdx = supportliLength - 1;
            }
            supportliSelected = $(supportli).eq(supportliIdx).addClass('nav-link-selected');
            $(supportliSelected).find('a').focus();
        }
    });

});


jQuery(document.documentElement).keyup(function (event) {    

    var owl = jQuery(".owl-carousel");

    // handle cursor keys
    if (event.keyCode == 37) {
       // go left
       owl.trigger('prev.owl');
    } else if (event.keyCode == 39) {
       // go right
       owl.trigger('next.owl');
    } 

});


function homeSearchQual() {
    localStorage.removeItem("subjectFilter");
    var sf = {
        filterText: $(".qualification-input").val()
    };
    localStorage.setItem("subjectFilter", JSON.stringify(sf));
    window.location.href = "https://sqa.org.uk/sqa/41285.html";
}

function homeSearchInternationalQual() {
    localStorage.removeItem("subjectFilter");
    var sf = {
        filterText: $(".international-qualification-input").val()
    };
    localStorage.setItem("subjectFilter", JSON.stringify(sf));
    window.location.href = "https://sqa.org.uk/sqa/41285.html?country=International";
}

function homeSearchUnit() {
    window.location.href = "https://www.sqa.org.uk/sqa/controller?p_service=Front.searchUnits&g=0&pMenuID=117&t=nq_unit%2Chn_unit%2Caq_unit%2Cacd_unit%2Cqcf_unit&Submit=Search&q=" + $(".unit-input").val();
}


function searchByTab(evt, name) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName("tabcontent");
    for (i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = "none";
    }
    tablinks = document.getElementsByClassName("tablinks");
    for (i = 0; i < tablinks.length; i++) {
      tablinks[i].className = tablinks[i].className.replace(" active", "");
    }
    document.getElementById(name).style.display = "flex";
    evt.currentTarget.className += " active";
}
